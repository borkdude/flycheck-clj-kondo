; -*- mode: emacs-lisp; lexical-binding: t -*-

(eldev-require-version "1.11.2")

(eldev-use-package-archive 'gnu-elpa)   ;; Needed for installing seq.el-2.24
(eldev-use-package-archive 'melpa)

(eldev-add-extra-dependencies 'test 'clojure-mode 'buttercup)

(setq byte-compile-docstring-max-column 120)

;; Windows CI lacks a valid GPG keyring for ELPA signatures
(when (eq system-type 'windows-nt)
  (setq package-check-signature nil))

(when (version<=  "29.1" emacs-version)
  (eldev-add-extra-dependencies 'test 'clojure-ts-mode))

(setq eldev-project-main-file "flycheck-clj-kondo.el")
